DB_HOST=db_호스트주소
DB_ROOT_PASSWORD=루트_패스워드
DB_USER=db_유저네임
DB_PASSWORD=db_패스워드

REDIS_HOST=redis_호스트주소

JWT_SECRET=jwt_시크릿_키
JWT_REFRESH=jwt_리프레시토큰_시크릿_키

GITHUB_CLIENT_ID=깃허브_클라이언트_아이디
GITHUB_CLIENT_SECRET=깃허브_클라이언트_시크릿

GOOGLE_CLIENT_ID=구글_클라이언트_아이디
GOOGLE_CLIENT_SECRET=구글_클라이언트_시크릿

FRONTEND_URL=프론트엔드_배포_주소

# 프론트가 백엔드와 다른 도메인에 배포될 때만 채운다(예: Vercel). 콤마로 여러 origin 구분 가능.
# 미설정 시 CorsConfig의 기본 origin 목록만 적용됨.
CORS_ADDITIONAL_ORIGINS=

# 프론트가 백엔드와 다른 도메인일 때만 None으로 설정(그 외엔 비워두면 기본값 Strict 유지).
# None으로 설정 시 cookie.secure(HTTPS)가 함께 켜져 있어야 브라우저가 쿠키를 허용한다.
COOKIE_SAME_SITE=

PORTONE_API_SECRET=포트원_api_키
PORTONE_STORE_ID=포트원_스토어_아이디
PORTONE_CHANNEL_KEY=포트원_채널_키
PORTONE_WEBHOOK_SECRET=포트원_웹훅_시크릿
PORTONE_WEBHOOK_NOTICE_URL=웹훅_라우팅_URL

# 비밀번호 재설정 메일 발송용 (Gmail이면 앱 비밀번호 발급 필요)
MAIL_USERNAME=발신용_지메일_주소
MAIL_PASSWORD=지메일_앱_비밀번호

# AI 질문 요약 / 태그 추천용 (미설정 시 해당 기능만 비활성화)
GEMINI_API_KEY=제미나이_api_키

# 최초 기동 시 자동 생성되는 관리자 계정
ADMIN_USERNAME=관리자_아이디
ADMIN_PASSWORD=관리자_비밀번호
ADMIN_NICKNAME=관리자_닉네임